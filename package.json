{
  "name": "slashclient",
  "version": "0.7.2",
  "description": "SlashClient – launcher Minecrafta",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "test:launch": "npm run build && node dist/cli.js",
    "icons": "electron scripts/make-icons.cjs",
    "test": "node scripts/test.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dmg-background": "electron scripts/make-dmg-background.cjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "skinview3d": "^3.4.2",
    "typescript": "^7.0.2",
    "adm-zip": "^0.6.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "allowScripts": {
    "electron@44.7.2": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  },
  "author": {
    "name": "slash3rss",
    "url": "https://slash3rss.dev"
  },
  "homepage": "https://slash3rss.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/slash3rss/SlashClient.git"
  },
  "build": {
    "appId": "dev.slash3rss.slashclient",
    "productName": "SlashClient",
    "copyright": "© slash3rss",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SlashClient"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icons",
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Slash3rss",
        "repo": "SlashClient",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "SlashClient ${version}",
      "background": "build/background.tiff",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 160,
          "y": 205,
          "type": "file"
        },
        {
          "x": 380,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
