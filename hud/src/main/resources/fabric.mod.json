{
	"schemaVersion": 1,
	"id": "slashclient-hud",
	"version": "${version}",
	"name": "SlashClient HUD",
	"description": "Nakładki w grze: FPS, ping, CPS, współrzędne, pancerz, efekty i klawisze. Prawy Shift otwiera edycję.",
	"authors": ["slash3rss"],
	"contact": { "homepage": "https://slash3rss.dev", "sources": "https://github.com/Slash3rss/SlashClient" },
	"license": "MIT",
	"icon": "assets/slashclient-hud/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.slash3rss.slashclient.hud.SlashHud"]
	},
	"mixins": ["slashclient-hud.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${range}",
		"java": ">=${java}",
		"fabric-api": "*"
	}
}
