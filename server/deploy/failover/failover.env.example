# /etc/slashclient/failover.env on the SPARE server only (chmod 600). Filled in by hand, never in the repo.

# the main server's own address (not Cloudflare's), checked every 30 s
PRIMARY_IP=93.95.119.130
# this spare server's addresses (IPv6 optional)
SELF_IP=
SELF_IPV6=
# the site's record in Cloudflare and its zone (Dashboard → slash3rss.dev → Overview → Zone ID)
CF_RECORD=slashclient.pl
CF_ZONE_ID=
# a token with only "Zone → DNS → Edit" for slash3rss.dev (My Profile → API Tokens)
CF_API_TOKEN=
# checks in a row without an answer before taking over (6 × 30 s = 3 minutes)
FAILS_NEEDED=6
# 0: the watchdog only writes to the log, the takeover is done by hand (promote.sh)
AUTO_PROMOTE=1
