# Caddy gets and renews the HTTPS certificate on its own.
client.slash3rss.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787
	header Strict-Transport-Security "max-age=31536000"
	log {
		output file /var/log/caddy/slashclient.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# other sites on this VPS (api.slash3rss.dev…), outside the SlashClient deploy
import /etc/caddy/sites/*.caddy
