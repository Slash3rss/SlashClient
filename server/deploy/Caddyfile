# SlashClient in CT 821 behind Nginx Proxy Manager (CT 800, 192.168.100.2), which holds the HTTPS
# certificates: Caddy here speaks plain HTTP and only keeps the redirects and headers.
{
	auto_https off
	servers {
		# the address NPM was reached from (Cloudflare's server, or the player): the last one in
		# X-Forwarded-For that is not NPM itself; the app then believes CF-Connecting-IP only from Cloudflare
		trusted_proxies static 192.168.100.2/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(app) {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Proto https
	}
	header Strict-Transport-Security "max-age=31536000"
}

http://slashclient.pl {
	import app
	log {
		output file /var/log/caddy/slashclient.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
}

http://www.slashclient.pl {
	redir https://slashclient.pl{uri} permanent
}

http://client.slash3rss.dev {
	@page {
		method GET HEAD
		header Accept *text/html*
		not path /v1/* /aktualizacje /aktualizacje/*
	}
	redir @page https://slashclient.pl{uri} permanent
	import app
	log {
		output file /var/log/caddy/slashclient-old.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
	}
}
